# ---------------------------------------------------------------------------
# PUBLIC REPRODUCIBILITY EVIDENCE — INTENTIONALLY TRACKED
# ---------------------------------------------------------------------------
# Curated CSV/JSON/README files used to:
#   - reproduce and verify manuscript Tables 5–13,
#   - support appendix results,
#   - compare rerun results against manuscript values,
#   - support statistical/post-processing checks.
#
# Keep these files compact and reviewer-facing. Do not copy complete raw
# campaign folders here.

!data/reproducibility/
!data/reproducibility/**

# Processed manuscript-facing CSV summaries are intentionally tracked.
!data/processed_results/
!data/processed_results/**

# Keep this file tracked.
!.gitignore


# ---------------------------------------------------------------------------
# SELECTIVE REVISION CAMPAIGN EVIDENCE — INTENTIONALLY TRACKED
# ---------------------------------------------------------------------------
# Results remain ignored by default. Only compact reproducibility evidence
# from the final revision campaign is exposed below.

!results/
results/**

# Allow Git to traverse the final campaign tree.
!results/revision_final_30seed_nofg/
!results/revision_final_30seed_nofg/**/


# ---------------------------------------------------------------------------
# CAMPAIGN MANIFESTS
# ---------------------------------------------------------------------------

!results/revision_final_30seed_nofg/manifests/**
# Includes:
#   batch_manifest.csv
#   dry_run_phase11.csv
#   dry_run_phase12b.csv
#   dry_run_phase12c.csv
#   and any other compact campaign-manifest files.


